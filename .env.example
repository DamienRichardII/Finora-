# Copier ce fichier en .env.local et compléter. Ne jamais commiter .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "false" en production pour masquer le bandeau et les contenus de démonstration
NEXT_PUBLIC_DEMO_MODE=true

# --- E-mails transactionnels (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="FINORA Academy <bonjour@votre-domaine.fr>"
CONTACT_TO_EMAIL=

# --- Supabase (phase 4) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement : ne jamais l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (phase 6, mode TEST pendant le développement) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# --- Vidéo (à choisir après comparatif : Mux / Bunny Stream / Cloudflare Stream) ---
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_SIGNING_KEY=
